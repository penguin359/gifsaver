#include <windows.h>
#include "platform_win32.h"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION "gifsaver"
END

IDD_CONFIG DIALOGEX 0, 0, 280, 118
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "gifsaver Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "&Animated GIF:", IDC_STATIC, 7, 9, 266, 8
    EDITTEXT        IDC_GIF, 7, 20, 210, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...", IDC_GIF_BROWSE, 223, 20, 50, 14
    AUTOCHECKBOX    "&Play sound", IDC_SOUND_ON, 7, 41, 266, 10
    LTEXT           "&Sound (WAV, optional):", IDC_STATIC, 7, 55, 266, 8
    EDITTEXT        IDC_SOUND, 7, 66, 210, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "B&rowse...", IDC_SOUND_BROWSE, 223, 66, 50, 14
    LTEXT           "", IDC_NOTE, 7, 86, 266, 8
    DEFPUSHBUTTON   "OK", IDOK, 169, 97, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 97, 50, 14
END
