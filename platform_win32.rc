#include <windows.h>
#include "platform_win32.h"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION "gifsaver"
END

IDD_CONFIG DIALOGEX 0, 0, 280, 104
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "gifsaver Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "&Animated GIF:", IDC_STATIC, 7, 9, 266, 8
    EDITTEXT        IDC_GIF, 7, 20, 210, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...", IDC_GIF_BROWSE, 223, 20, 50, 14
    LTEXT           "&Sound (WAV, optional):", IDC_STATIC, 7, 41, 266, 8
    EDITTEXT        IDC_SOUND, 7, 52, 210, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "B&rowse...", IDC_SOUND_BROWSE, 223, 52, 50, 14
    LTEXT           "", IDC_NOTE, 7, 72, 266, 8
    DEFPUSHBUTTON   "OK", IDOK, 169, 83, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 83, 50, 14
END
