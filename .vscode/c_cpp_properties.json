{
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/vcpkg_installed/x64-windows-static/include"
            ],
            "defines": ["_CRT_SECURE_NO_WARNINGS"],
            "cStandard": "c11",
            "intelliSenseMode": "windows-msvc-x64"
        },
        {
            "name": "Linux",
            "includePath": ["${workspaceFolder}"],
            "compilerPath": "/usr/bin/cc",
            "cStandard": "c11",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ]
}
